{
  "id": "S26_unprompted_frame",
  "title": "A photo arrives with nothing said at all",
  "modality": "visual",
  "description": "No transcript, no intent, no slots \u2014 just an image. Everything downstream has to be derived from the pixels: the perception binds a slot, the slot implies a goal, the goal makes a tool plannable. Any step that quietly depended on somebody having spoken first breaks here.",
  "probes": [
    "perception-only session",
    "intent inference from a slot",
    "no speech context"
  ],
  "manifest": [
    {
      "name": "lookup_manual",
      "description": "look up a device fault in the service manual",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        }
      ]
    },
    {
      "name": "diagnose_sound",
      "description": "identify the mechanical cause of an appliance sound",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "sound",
          "type": "string",
          "required": true,
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    },
    {
      "name": "create_ticket",
      "description": "raise a service ticket for an engineer visit",
      "mutating": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        },
        {
          "name": "sound",
          "type": "string",
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    }
  ],
  "env": {
    "latency_ms": {
      "search_flights": 700,
      "search_hotels": 650,
      "book_flight": 900,
      "cancel_booking": 200,
      "get_booking_status": 120,
      "lookup_manual": 500,
      "diagnose_sound": 450,
      "create_ticket": 800
    }
  },
  "events": [
    {
      "type": "session_start",
      "t": 0.0,
      "session_id": "S26"
    },
    {
      "type": "tool_manifest",
      "t": 0.0,
      "manifest": "@manifest"
    },
    {
      "type": "video_frame",
      "t": 200,
      "frame_id": "washer_error_e4",
      "path": "media/scenarios/frames/washer_error_e4.png"
    },
    {
      "type": "session_end",
      "t": 3000,
      "reason": "complete"
    }
  ],
  "expect": {
    "intent": "troubleshoot",
    "slots": {
      "label": "washer_error_e4"
    },
    "tools_called": [
      "lookup_manual"
    ],
    "max_first_response_ms": 300
  }
}
