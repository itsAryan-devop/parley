{
  "id": "S24_manifest_arrives_late",
  "title": "Tools show up after the conversation has started",
  "modality": "text",
  "description": "The manifest is an event, not configuration, so it can arrive mid-session and can replace what was there. The agent must not have cached a tool list, a vocabulary, or an intent map derived from the old one \u2014 all three are re-derived, which is the property that makes unseen tools work.",
  "probes": [
    "dynamic manifest",
    "vocabulary re-derivation",
    "unseen tools"
  ],
  "manifest": [
    {
      "name": "lookup_manual",
      "description": "look up a device fault in the service manual",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        }
      ]
    },
    {
      "name": "diagnose_sound",
      "description": "identify the mechanical cause of an appliance sound",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "sound",
          "type": "string",
          "required": true,
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    },
    {
      "name": "create_ticket",
      "description": "raise a service ticket for an engineer visit",
      "mutating": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        },
        {
          "name": "sound",
          "type": "string",
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    }
  ],
  "env": {
    "latency_ms": {
      "search_flights": 700,
      "search_hotels": 650,
      "book_flight": 900,
      "cancel_booking": 200,
      "get_booking_status": 120,
      "lookup_manual": 500,
      "diagnose_sound": 450,
      "create_ticket": 800
    }
  },
  "events": [
    {
      "type": "session_start",
      "t": 0.0,
      "session_id": "S24"
    },
    {
      "type": "transcript_chunk",
      "t": 100,
      "text": "the washing machine is grinding",
      "end_of_turn": true
    },
    {
      "type": "tool_manifest",
      "t": 600.0,
      "manifest": "@manifest"
    },
    {
      "type": "transcript_chunk",
      "t": 900,
      "text": "it's grinding, have a look at that",
      "end_of_turn": true
    },
    {
      "type": "session_end",
      "t": 4000,
      "reason": "complete"
    }
  ],
  "expect": {
    "intent": "troubleshoot",
    "slots": {
      "sound": "grinding"
    },
    "tools_called": [
      "diagnose_sound"
    ],
    "notes": "Nothing may be dispatched before the manifest arrives."
  }
}
