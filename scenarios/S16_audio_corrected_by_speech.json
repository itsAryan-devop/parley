{
  "id": "S16_audio_corrected_by_speech",
  "title": "A clip is superseded by the user simply saying what it was",
  "modality": "audio",
  "description": "Perception binds `sound` from the recording; the user then corrects it in words. Speech outranks a classifier, the diagnosis in flight read the old value and must be cancelled, and the snapshot must end on what the user said rather than what we heard.",
  "probes": [
    "cross-modal correction",
    "speech overrides perception",
    "selective cancellation"
  ],
  "manifest": [
    {
      "name": "lookup_manual",
      "description": "look up a device fault in the service manual",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        }
      ]
    },
    {
      "name": "diagnose_sound",
      "description": "identify the mechanical cause of an appliance sound",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "sound",
          "type": "string",
          "required": true,
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    },
    {
      "name": "create_ticket",
      "description": "raise a service ticket for an engineer visit",
      "mutating": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        },
        {
          "name": "sound",
          "type": "string",
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    }
  ],
  "env": {
    "latency_ms": {
      "search_flights": 700,
      "search_hotels": 650,
      "book_flight": 900,
      "cancel_booking": 200,
      "get_booking_status": 120,
      "lookup_manual": 500,
      "diagnose_sound": 1800,
      "create_ticket": 800
    }
  },
  "events": [
    {
      "type": "session_start",
      "t": 0.0,
      "session_id": "S16"
    },
    {
      "type": "tool_manifest",
      "t": 0.0,
      "manifest": "@manifest"
    },
    {
      "type": "transcript_chunk",
      "t": 100,
      "text": "listen to the machine",
      "end_of_turn": true
    },
    {
      "type": "audio_clip",
      "t": 300,
      "clip_id": "grinding",
      "path": "media/scenarios/audio/grinding.wav"
    },
    {
      "type": "interruption",
      "t": 900,
      "source": "vad"
    },
    {
      "type": "transcript_chunk",
      "t": 920,
      "text": "actually that's the beeping one, not the grinding",
      "end_of_turn": true
    },
    {
      "type": "session_end",
      "t": 5200,
      "reason": "complete"
    }
  ],
  "expect": {
    "slots": {
      "sound": "beeping"
    },
    "cancelled_tools": [
      "diagnose_sound"
    ],
    "no_duplicate_effects": true,
    "notes": "The diagnosis for `grinding` read `sound` and must not survive."
  }
}
