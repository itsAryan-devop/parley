{
  "id": "S28_audio_corrupt_clip",
  "title": "A clip that is not really a clip",
  "modality": "audio",
  "description": "A truncated upload \u2014 bytes that are not a WAV at all, which is what a dropped connection produces. The agent must ask rather than crash, and must not invent a label to fill the gap. Graceful degradation on bad input is not glamorous but it is the difference between a scenario scoring partially and scoring zero.",
  "probes": [
    "decode failure",
    "graceful degradation",
    "clarification"
  ],
  "manifest": [
    {
      "name": "lookup_manual",
      "description": "look up a device fault in the service manual",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        }
      ]
    },
    {
      "name": "diagnose_sound",
      "description": "identify the mechanical cause of an appliance sound",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "sound",
          "type": "string",
          "required": true,
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    },
    {
      "name": "create_ticket",
      "description": "raise a service ticket for an engineer visit",
      "mutating": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        },
        {
          "name": "sound",
          "type": "string",
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    }
  ],
  "env": {
    "latency_ms": {
      "search_flights": 700,
      "search_hotels": 650,
      "book_flight": 900,
      "cancel_booking": 200,
      "get_booking_status": 120,
      "lookup_manual": 500,
      "diagnose_sound": 450,
      "create_ticket": 800
    }
  },
  "events": [
    {
      "type": "session_start",
      "t": 0.0,
      "session_id": "S28"
    },
    {
      "type": "tool_manifest",
      "t": 0.0,
      "manifest": "@manifest"
    },
    {
      "type": "transcript_chunk",
      "t": 100,
      "text": "have a listen and tell me what's wrong",
      "end_of_turn": true
    },
    {
      "type": "audio_clip",
      "t": 400,
      "clip_id": "corrupt",
      "path": "media/scenarios/audio/corrupt.wav"
    },
    {
      "type": "session_end",
      "t": 3000,
      "reason": "complete"
    }
  ],
  "expect": {
    "must_clarify": true,
    "absent_slots": [
      "sound"
    ],
    "tools_not_called": [
      "diagnose_sound",
      "create_ticket"
    ]
  }
}
