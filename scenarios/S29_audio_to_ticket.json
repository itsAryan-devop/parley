{
  "id": "S29_audio_to_ticket",
  "title": "From a recording to a service ticket",
  "modality": "audio",
  "description": "The full chain in the audio modality: a clip binds the sound, the sound drives a diagnosis, and the user then asks for an engineer. The ticket is state-modifying, so it needs a commit verb and exactly one of it must reach the environment however many times the user asks.",
  "probes": [
    "audio-to-mutating chain",
    "commit verb gating",
    "idempotency"
  ],
  "manifest": [
    {
      "name": "lookup_manual",
      "description": "look up a device fault in the service manual",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "required": true,
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        }
      ]
    },
    {
      "name": "diagnose_sound",
      "description": "identify the mechanical cause of an appliance sound",
      "read_only": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "sound",
          "type": "string",
          "required": true,
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    },
    {
      "name": "create_ticket",
      "description": "raise a service ticket for an engineer visit",
      "mutating": true,
      "intent": "troubleshoot",
      "params": [
        {
          "name": "label",
          "type": "string",
          "enum": [
            "router_power_led_red",
            "router_wan_led_amber",
            "washer_error_e4",
            "washer_drum_noise",
            "tv_hdmi_no_signal"
          ]
        },
        {
          "name": "sound",
          "type": "string",
          "enum": [
            "beeping",
            "continuous_tone",
            "grinding",
            "clicking",
            "silence"
          ]
        }
      ]
    }
  ],
  "env": {
    "latency_ms": {
      "search_flights": 700,
      "search_hotels": 650,
      "book_flight": 900,
      "cancel_booking": 200,
      "get_booking_status": 120,
      "lookup_manual": 500,
      "diagnose_sound": 450,
      "create_ticket": 800
    }
  },
  "events": [
    {
      "type": "session_start",
      "t": 0.0,
      "session_id": "S29"
    },
    {
      "type": "tool_manifest",
      "t": 0.0,
      "manifest": "@manifest"
    },
    {
      "type": "transcript_chunk",
      "t": 100,
      "text": "listen to this racket",
      "end_of_turn": true
    },
    {
      "type": "audio_clip",
      "t": 350,
      "clip_id": "grinding",
      "path": "media/scenarios/audio/grinding.wav"
    },
    {
      "type": "transcript_chunk",
      "t": 1600,
      "text": "raise a ticket for that please",
      "end_of_turn": true
    },
    {
      "type": "transcript_chunk",
      "t": 2600,
      "text": "did you raise it? raise a ticket",
      "end_of_turn": true
    },
    {
      "type": "session_end",
      "t": 5500,
      "reason": "complete"
    }
  ],
  "expect": {
    "intent": "troubleshoot",
    "slots": {
      "sound": "grinding"
    },
    "tools_called": [
      "diagnose_sound",
      "create_ticket"
    ],
    "live_effects": [
      {
        "tool": "create_ticket",
        "args": {
          "sound": "grinding"
        }
      }
    ],
    "no_duplicate_effects": true
  }
}
